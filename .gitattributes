# 统一换行符：仓库内一律 LF，避免 Windows 检出时产生噪音 diff
* text=auto eol=lf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# 文档与源码按文本处理
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.py text eol=lf
